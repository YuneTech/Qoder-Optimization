# Normalize line endings in the repository; check out per platform.
* text=auto eol=lf

# Windows-native scripts keep CRLF so cmd.exe / PowerShell behave as written.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never diff or convert.
*.zip binary
*.tgz binary
*.tar.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
